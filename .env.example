# App
APP_ENV=dev
DEBUG=false
LOG_LEVEL=INFO

# Database
POSTGRES_USER=skillbridge_user
POSTGRES_PASSWORD=skillbridge_password
POSTGRES_DB=skillbridge_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_ECHO=false

# AI / OpenRouter
OPENROUTER_API_KEY=CHANGE_ME
AI_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
AI_CHAT_MODEL=deepseek/deepseek-v4-flash
AI_CHAT_MODEL_LIGHT=deepseek/deepseek-v4-flash
AI_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT=60.0
AI_MAX_RETRIES=2

# Scraper
SCRAPER_REQUEST_DELAY=0.5
SCRAPER_CONNECT_TIMEOUT=10.0
SCRAPER_READ_TIMEOUT=20.0
SCRAPER_WRITE_TIMEOUT=10.0
SCRAPER_POOL_TIMEOUT=5.0
SCRAPER_MAX_RETRIES=3
SCRAPER_RETRY_BACKOFF_FACTOR=1.5
SCRAPER_PAGE_SIZE=30
SCRAPER_MAX_PAGES=100

# Pipeline
ENRICHMENT_CONCURRENCY=10
DEFAULT_LOCATION=Tehran

# Scheduler
SCHEDULER_ENABLED=false
DISCOVERY_INTERVAL_MINUTES=360
ENRICHMENT_INTERVAL_MINUTES=60